<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IterVC.Linux</AssemblyName>
    <RootNamespace>IterVC.Linux</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IterVC.Core/IterVC.Core.csproj" />
    <ProjectReference Include="../IterVC.UI/IterVC.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../IterVC.Desktop/Assets/icon.ico" Link="Assets/icon.ico" />
    <!-- Reuse the original desktop semantic color palette without including its
         Windows-specific Application code or view models. -->
  </ItemGroup>
  <!-- Copy the existing Windows XAML palette to an .xml intermediate resource.
       Avalonia otherwise treats .axaml files as compiled views and removes
       them from CLR manifest resources. Copying preserves the source of truth. -->
  <Target Name="BundleOriginalDesktopPalette" BeforeTargets="AssignTargetPaths">
    <Copy SourceFiles="../IterVC.Desktop/App.axaml"
          DestinationFiles="$(IntermediateOutputPath)WindowsThemePalette.xml" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)WindowsThemePalette.xml"
                        LogicalName="IterVC.Linux.WindowsThemePalette" />
    </ItemGroup>
  </Target>
  <ItemGroup>
  </ItemGroup>
  <!-- The Rust process is embedded into the .NET single-file executable. -->
  <ItemGroup>
    <EmbeddedResource Include="../rust/target/release/itervc-linux-pipewire"
                      LogicalName="IterVC.Linux.NativeAudioCli" />
    <!-- The same native DSP implementation and RNNoise model as Windows.
         It is extracted next to the Rust worker from the one-file publish. -->
    <EmbeddedResource Include="../rust/target/release/libiter_vc_rnnoise.so"
                      LogicalName="IterVC.Linux.NativeRnNoise" />
  </ItemGroup>
  <Target Name="RequireLinuxNativeBackend" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('../rust/target/release/itervc-linux-pipewire')"
           Text="Build rust/linux-pipewire in Release mode before building the Linux GUI." />
    <Error Condition="!Exists('../rust/target/release/libiter_vc_rnnoise.so')"
           Text="Build native/iter_vc_rnnoise for Linux and copy libiter_vc_rnnoise.so into rust/target/release before building the Linux GUI." />
  </Target>
</Project>
