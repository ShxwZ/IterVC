---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  hint?: string;
}

const { src, alt, caption, hint } = Astro.props;
const cleanPath = src.replace(/^\/+/, '');
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const imageUrl = `${base}${cleanPath}`;
---

<figure class="itervc-screenshot">
  <div class="itervc-screenshot__stage">
    <div class="itervc-screenshot__placeholder" aria-hidden="true">
      <span class="itervc-screenshot__eyebrow">Screenshot pending</span>
      <strong>{cleanPath}</strong>
      {hint && <span>{hint}</span>}
    </div>
    <img
      src={imageUrl}
      alt={alt}
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
