<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IterVC.WasapiAB</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same exact source code as Windows production; do not edit/copy. -->
    <Compile Include="../../IterVC.Audio/Buffers/RealtimeAudioBuffer.cs"
             Link="ProductionBaseline/RealtimeAudioBuffer.cs" />
    <Compile Include="../../IterVC.Audio/Buffers/RealtimeAudioBufferSnapshot.cs"
             Link="ProductionBaseline/RealtimeAudioBufferSnapshot.cs" />
  </ItemGroup>
</Project>
