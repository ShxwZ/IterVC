<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IterVC.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ver nota en IterVC.Desktop.csproj: el interop de Process Loopback asume x64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="VRCOscLib" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IterVC.Core\IterVC.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildDeepFilterNetNative" BeforeTargets="Compile" Condition="'$(OS)' == 'Windows_NT' and '$(IterVCSkipDeepFilter)' != 'true' and !Exists('$(TargetDir)iter_vc_deep_filter.dll')">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build-DeepFilterNet.ps1&quot; -OutputDirectory &quot;$(TargetDir)&quot;" />
  </Target>

  <Target Name="CopyDeepFilterNetNativeToOutput" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and Exists('$(TargetDir)iter_vc_deep_filter.dll')">
    <Copy SourceFiles="$(TargetDir)iter_vc_deep_filter.dll" DestinationFolder="$(TargetPath)\.." SkipUnchangedFiles="true" />
  </Target>

</Project>
